{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "audio_convert",
  "version": "../package.json",
  "identifier": "com.oud0n.audioconvert",
  "build": {
    "frontendDist": "../app",
    "devUrl": "http://localhost:8888",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Convert",
        "width": 1000,
        "height": 600,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "binaries/audio-convert-ffmpeg",
      "binaries/audio-convert-sox"
    ],
    "resources": {
      "binaries/ffmpeg-LICENSE.txt": "licenses/ffmpeg-LICENSE.txt",
      "binaries/sox-LICENSE.txt": "licenses/sox-LICENSE.txt"
    }
  }
}
